# Server environment template (12-Factor)

# Environment: development | production | test
ENVIRONMENT=development

# Application
APP_NAME=Navigate LA 2028 API
APP_VERSION=1.0.0
DEBUG=true

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/navigate_la28

# PostGIS-specific settings
POSTGIS_ENABLED=true
SPATIAL_REF_SYS_SRID=4326
GEOMETRY_SRID=4326

# Database connection settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30

# Security
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=http://localhost:3030,http://localhost:3000

# API
API_PREFIX=/api
DOCS_URL=/docs
REDOC_URL=/redoc

# External Services
GOOGLE_MAPS_API_KEY=

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_CACHE_TTL=3600

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100

# Logging and monitoring
LOG_LEVEL=DEBUG
LOG_FORMAT=text
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true
