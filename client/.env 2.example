# Frontend Environment Configuration
# Copy this file to .env.local and update values as needed

# API Configuration
# Base URL for API requests (will be proxied through Nginx)
REACT_APP_API_BASE_URL=/api

# Development Settings
# Set to true for development mode
REACT_APP_DEV_MODE=true

# Security Configuration
# Disable source map generation in production
GENERATE_SOURCEMAP=false

# Bundle Analysis
# Set to true to analyze bundle size
ANALYZE_BUNDLE=false

# Browser Settings
# Set to 'none' to prevent auto-opening browser
BROWSER=none

# Node Options
# Memory optimization for Node.js
NODE_OPTIONS=--max_old_space_size=4096

# Development Server
# Port for development server (not used in production with Nginx)
PORT=3030

# Fast Refresh
# Enable React Fast Refresh for development
FAST_REFRESH=true

# ESLint Configuration
# Allow ESLint errors in development
ESLINT_NO_DEV_ERRORS=false

# TypeScript Configuration
# Allow TypeScript compilation errors in development
TSC_COMPILE_ON_ERROR=false
